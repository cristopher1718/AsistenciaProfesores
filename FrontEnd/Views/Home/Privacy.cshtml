@{
    ViewData["Title"] = "Creador & Contacto";
}

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creador & Contacto</title>
    <meta name="description" content="Información de contacto del desarrollador del sistema.">
    <meta name="keywords" content="Cristopher Salas, Web Developer, Contacto, Soporte, Desarrollo de Software">
    <meta name="author" content="Cristopher Salas">

    <!-- Integración de Tailwind CSS para la previsualización -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Integración de FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
            :root {
                --blue-bg: #070d19;
                --blue-card-1: #0d1b32;
                --blue-card-2: #13274a;
                --blue-border: #1e3a6e;
                --accent-cyan: #38bdf8;
                --text-muted: #94a3b8;
            }

            section {
                background-color: #030712;
                font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            }

            .contact-container {
                background-color: var(--blue-bg);
                border-radius: 16px;
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            }

            .custom-card {
                background: linear-gradient(145deg, var(--blue-card-1) 0%, var(--blue-card-2) 100%);
                border: 1px solid var(--blue-border);
                border-radius: 16px;
                box-shadow: 0 10px 30px -15px rgba(0, 0, 0, 0.7);
                transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }

                .custom-card:hover {
                    transform: translateY(-5px);
                    border-color: var(--accent-cyan);
                    box-shadow: 0 20px 40px -10px rgba(56, 189, 248, 0.15);
                }

            .social-link .icon-box {
                transition: all 0.3s ease;
            }

            .social-link:hover .icon-box {
                background-color: var(--accent-cyan);
                transform: scale(1.05);
            }

                .social-link:hover .icon-box i {
                    color: #070d19 !important; /* Contraste oscuro al hacer hover */
                }
    </style>
</head>

<section class="min-h-screen flex items-center justify-center p-4">

    <!-- Contenedor principal con fondo oscuro adaptado -->
    <div class="contact-container max-w-4xl w-full mx-auto p-6 md:p-12">

        <!-- Encabezado -->
        <div class="mb-12 border-b border-[#1e3a6e] pb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-white mb-2 tracking-tight">
                <i class="fas fa-id-card text-sky-400 mr-2 drop-shadow-md"></i> INFORMACIÓN DE <span class="text-sky-400">CONTACTO</span>
            </h1>
            <p class="text-blue-200/70 font-medium tracking-wide">Desarrollo y Soporte del Sistema</p>
        </div>

        <!-- Grid de Tarjetas -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            <!-- Tarjeta de Perfil -->
            <div class="custom-card p-8 flex flex-col items-center text-center">
                <div class="w-24 h-24 bg-[#0a1526] rounded-full flex items-center justify-center mb-5 border border-sky-400/30 shadow-[0_0_15px_rgba(56,189,248,0.15)] relative">
                    <!-- Efecto de brillo detrás del icono -->
                    <div class="absolute inset-0 rounded-full bg-sky-400 blur-md opacity-20"></div>
                    <i class="fas fa-code text-3xl text-sky-400 relative z-10"></i>
                </div>

                <h2 class="text-2xl font-bold text-white mb-1">Cristopher Salas</h2>
                <p class="text-sky-400 text-sm font-bold tracking-widest uppercase mb-4">Web Developer</p>

                <div class="w-12 h-0.5 bg-sky-400/30 mb-4"></div>

                <p class="text-blue-100/70 text-sm leading-relaxed">
                    Responsable del diseño, mantenimiento y optimización de la plataforma.
                    Enfocado en crear experiencias digitales fluidas y de alto rendimiento.
                </p>
            </div>

            <!-- Tarjeta de Contacto -->
            <div class="custom-card p-8">
                <h3 class="text-lg font-bold mb-6 flex items-center text-white">
                    <span class="w-8 h-1 bg-sky-400 mr-3 rounded-full"></span> CONECTAR
                </h3>

                <div class="space-y-5">
                    <!-- Teléfono -->
                    <div class="flex items-center group social-link">
                        <div class="icon-box w-11 h-11 bg-[#0a1526] border border-[#1e3a6e] rounded-lg flex items-center justify-center mr-4">
                            <i class="fas fa-phone text-sky-400/80"></i>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase text-blue-300/60 font-bold tracking-widest">Teléfono</p>
                            <p class="text-gray-100 font-medium tracking-wide">8841-3793</p>
                        </div>
                    </div>

                    <!-- Email -->
                    <a href="mailto:cristopher1718@yahoo.es" class="flex items-center group social-link no-underline">
                        <div class="icon-box w-11 h-11 bg-[#0a1526] border border-[#1e3a6e] rounded-lg flex items-center justify-center mr-4">
                            <i class="fas fa-envelope text-sky-400/80"></i>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase text-blue-300/60 font-bold tracking-widest">Email</p>
                            <p class="text-gray-100 font-medium group-hover:text-sky-400 transition-colors">cristopher1718@yahoo.es</p>
                        </div>
                    </a>

                    <!-- GitHub -->
                    <a href="https://github.com/cristopher1718" target="_blank" class="flex items-center group social-link no-underline">
                        <div class="icon-box w-11 h-11 bg-[#0a1526] border border-[#1e3a6e] rounded-lg flex items-center justify-center mr-4">
                            <i class="fab fa-github text-sky-400/80"></i>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase text-blue-300/60 font-bold tracking-widest">GitHub</p>
                            <p class="text-gray-100 font-medium group-hover:text-sky-400 transition-colors">/cristopher1718</p>
                        </div>
                    </a>

                    <!-- Instagram -->
                    <a href="https://www.instagram.com/cristopher1718" target="_blank" class="flex items-center group social-link no-underline">
                        <div class="icon-box w-11 h-11 bg-[#0a1526] border border-[#1e3a6e] rounded-lg flex items-center justify-center mr-4">
                            <i class="fab fa-instagram text-sky-400/80"></i>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase text-blue-300/60 font-bold tracking-widest">Instagram</p>
                            <p class="text-gray-100 font-medium group-hover:text-sky-400 transition-colors">cristopher1718</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

</section>